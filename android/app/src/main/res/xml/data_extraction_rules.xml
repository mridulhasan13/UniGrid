<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ (API 31+) data extraction rules for device-to-device transfers.
    See: https://developer.android.com/guide/topics/data/autobackup#xml-syntax-android-12
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude shared preferences that contain auth tokens -->
        <exclude domain="sharedpref" path="FlutterSharedPreferences.xml" />
        <!-- Exclude all cached files -->
        <exclude domain="cache" path="." />
        <exclude domain="external-cache" path="." />
    </cloud-backup>
    <device-transfer>
        <!-- Allow transferring user preferences between devices -->
        <include domain="sharedpref" path="." />
        <!-- Exclude cache -->
        <exclude domain="cache" path="." />
    </device-transfer>
</data-extraction-rules>
