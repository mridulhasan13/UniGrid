rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isRootAdmin(auth) {
      return auth.token.keys().hasAll(['email']) && (
        auth.token.email.lower() == 'mridul.owner@unigrid.app' ||
        auth.token.email.lower() == 'mridulhasan13@gmail.com' ||
        exists(/databases/$(database)/documents/root_admins/$(auth.token.email.lower()))
      ) || exists(/databases/$(database)/documents/root_admins/$(auth.uid));
    }
    
    function isApprovedUser() {
      return isAuthenticated() && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isApproved == true ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isCR == true ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true ||
        isRootAdmin(request.auth)
      );
    }
    
    function belongsToScope(dept, batch) {
      return isRootAdmin(request.auth) || (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.department == dept &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.batch == batch
      );
    }
    
    function isCR(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data.isCR == true ||
             get(/databases/$(database)/documents/users/$(userId)).data.isAdmin == true ||
             isRootAdmin(request.auth);
    }

    // Root admins list - read-only for clients, updates disabled from client
    match /root_admins/{doc} {
      allow read: if isAuthenticated();
      allow write: if false;
    }
    
    // User profiles matching UID
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAuthenticated() && (
        (request.auth.uid == userId && 
         (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['isCR', 'isAdmin', 'isApproved']) ||
          isRootAdmin(request.auth)
         )
        ) ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isCR == true ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true
      );
      allow delete: if isAuthenticated() && (
        request.auth.uid == userId || 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isCR == true ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true ||
        isRootAdmin(request.auth)
      );
    }
    
    // Department & Batch scoped collections
    match /depts/{dept}/batches/{batch}/{collection}/{docId} {
      allow read: if isApprovedUser() && belongsToScope(dept, batch);
      
      // For general chat and student uploads (materials)
      allow create: if isApprovedUser() && belongsToScope(dept, batch) && (
        collection == 'chat_messages' || collection == 'materials'
      );
      allow update: if isApprovedUser() && belongsToScope(dept, batch) && (
        (collection == 'chat_messages' && (
          request.auth.uid == resource.data.authorId || 
          isCR(request.auth.uid) ||
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seenBy'])
        )) ||
        (collection == 'materials' && (
          request.auth.uid == resource.data.uploadedByUserId ||
          isCR(request.auth.uid)
        ))
      );
      allow delete: if isApprovedUser() && belongsToScope(dept, batch) && (
        (collection == 'chat_messages' && (
          request.auth.uid == resource.data.authorId || 
          isCR(request.auth.uid)
        )) ||
        (collection == 'materials' && (
          request.auth.uid == resource.data.uploadedByUserId ||
          isCR(request.auth.uid)
        ))
      );
      
      // For CR-only collections: announcements, schedule, default_schedule, overrides, metadata, config, courses
      allow write: if isApprovedUser() && belongsToScope(dept, batch) && isCR(request.auth.uid) && (
        collection == 'announcements' || 
        collection == 'schedule' || 
        collection == 'default_schedule' || 
        collection == 'schedule_overrides' || 
        collection == 'routine_metadata' || 
        collection == 'config' || 
        collection == 'courses'
      );
    }
    
    // Private conversations (DMs)
    match /conversations/{conversationId} {
      allow read, write: if isAuthenticated() && (
        request.auth.uid in resource.data.participants || 
        request.auth.uid in request.resource.data.participants
      );
      
      match /messages/{messageId} {
        allow read, write: if isAuthenticated() && (
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants
        );
      }
    }
    
    // Admin request nominations
    match /admin_requests/{requestId} {
      allow create: if isAuthenticated();
      allow read, update, delete: if isAuthenticated() && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isCR == true ||
        isRootAdmin(request.auth)
      );
    }

    // User-generated content reports & moderation flags (Play Store UGC Policy)
    match /reports/{reportId} {
      allow create: if isAuthenticated();
      allow read, update, delete: if isAuthenticated() && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isCR == true ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true ||
        isRootAdmin(request.auth)
      );
    }
    
    // App update / admin settings check
    match /admin_settings/{doc} {
      allow read: if true;
      allow write: if isAuthenticated() && isRootAdmin(request.auth);
    }

    // App Config (Maintenance mode, versioning, storage metrics & config)
    match /app_config/{doc} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    
    // General / Global announcements (University-wide notices)
    match /general_announcements/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
  }
}
